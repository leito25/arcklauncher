if(NOT EXISTS "${GAME_DIR}/meta.json")
    message(FATAL_ERROR "Game metadata not found: ${GAME_DIR}/meta.json")
endif()
file(READ "${GAME_DIR}/meta.json" metadata)
string(JSON title ERROR_VARIABLE error GET "${metadata}" title)
if(error OR title STREQUAL "")
    message(FATAL_ERROR "Game metadata has no valid title: ${GAME_DIR}/meta.json")
endif()
string(JSON executable ERROR_VARIABLE error GET "${metadata}" executable)
if(error OR NOT executable STREQUAL EXPECTED_EXECUTABLE OR NOT EXISTS "${GAME_DIR}/${executable}")
    message(FATAL_ERROR "Game metadata or executable is invalid: ${GAME_DIR}")
endif()
if(DEFINED REQUIRED_LIBRARY AND NOT EXISTS "${GAME_DIR}/${REQUIRED_LIBRARY}")
    message(FATAL_ERROR "Game library not found: ${GAME_DIR}/${REQUIRED_LIBRARY}")
endif()
